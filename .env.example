# Copie para .env (nunca commitar o .env)
# Sem GOOGLE_API_KEY o agente LLM usa uma resposta mockada local.
GOOGLE_API_KEY=
# Modelo Gemini usado em backend/services/llm_agent.py
GEMINI_MODEL=gemini-3.1-flash-lite
# Intervalo (horas) e cooldown (horas) do monitoramento climatico [M5]
ALERT_MONITOR_INTERVAL_HOURS=6
ALERT_COOLDOWN_HOURS=24
# Banco PostgreSQL (ex.: Neon serverless exige ?sslmode=require no final)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/kultiva_db
# Origens permitidas no CORS para o frontend (separadas por virgula, ex.: https://seu-app.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex opcional para aceitar preview deploys (ex.: ^https://.*\.vercel\.app$)
CORS_ORIGIN_REGEX=
# Provedor de dados NASA: mock | real
NASA_PROVIDER=mock
# Perfil climatico simulavel no provedor mock (A9): normal | seca | chuva_extrema | onda_de_calor
NASA_MOCK_PROFILE=normal
# Complemento/fallback automatico via API publica NASA POWER quando colecoes Earthdata estiverem vazias (true|false)
NASA_POWER_FALLBACK=false
# Integracao direta com FAO GAEZ v5 (Suitability and Attainable Yield, HWSD v2.01, CMIP6 e relevo) na simulacao (true|false)
GAEZ_ENABLED=true
# Integracao direta com FAO ECOCROP (zona de conforto termico/hidrico e familia botanica) (true|false)
ECOCROP_ENABLED=true
# Integracao com Embrapa AGROFIT v1 (riscos fitossanitarios e pragas por nome cientifico) (true|false)
AGROFIT_ENABLED=true
# Credenciais Embrapa AgroAPI (https://www.agroapi.cnptia.embrapa.br/store/) para AGROFIT
AGROFIT_ACCESS_TOKEN=
EMBRAPA_CONSUMER_KEY=
EMBRAPA_CONSUMER_SECRET=
# Integracao leve de elevacao/declividade SRTM (Open-Meteo DEM) e focos de calor NASA FIRMS (true|false)
TERRAIN_HAZARDS_ENABLED=true
# Chave gratuita da NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_SNPP_NRT
# Janela em dias para consulta de datasets reais
NASA_REAL_DAYS_BACK=5
# Credenciais NASA Earthdata (apenas para acesso autenticado ao Earthdata quando NASA_PROVIDER=real)
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
