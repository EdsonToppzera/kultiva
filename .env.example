# Copie para .env (nunca commitar o .env)
# Sem GOOGLE_API_KEY o agente LLM usa uma resposta mockada local.
GOOGLE_API_KEY=
# Modelo Gemini usado em backend/services/llm_agent.py
GEMINI_MODEL=gemini-2.5-flash
# Intervalo (horas) do monitoramento climatico periodico [M5]
ALERT_MONITOR_INTERVAL_HOURS=6
# Provedor de dados NASA: mock | real (real ainda nao implementado)
NASA_PROVIDER=mock
# Credenciais NASA Earthdata (apenas para o provedor real)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
