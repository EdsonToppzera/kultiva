# Copie para .env (nunca commitar o .env)
# Sem GOOGLE_API_KEY o agente LLM usa uma resposta mockada local.
GOOGLE_API_KEY=
# Modelo Gemini usado em backend/services/llm_agent.py
GEMINI_MODEL=gemini-2.5-flash
# Intervalo (horas) e cooldown (horas) do monitoramento climatico [M5]
ALERT_MONITOR_INTERVAL_HOURS=6
ALERT_COOLDOWN_HOURS=24
# Origens permitidas no CORS para o frontend (separadas por virgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Provedor de dados NASA: mock | real
NASA_PROVIDER=mock
# Perfil climatico simulavel no provedor mock (A9): normal | seca | chuva_extrema | onda_de_calor
NASA_MOCK_PROFILE=normal
# Credenciais NASA Earthdata (apenas para o provedor real)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
